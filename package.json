{
  "name": "gymgate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/build-server.mjs && node dist-server/index.cjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && node scripts/build-server.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "preview": "vite preview",
    "start": "node dist-server/index.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:docs": "node scripts/sync-docs.mjs",
    "setup-whatsapp-gateway": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whatsapp-gateway.ps1",
    "build:exe": "node scripts/build-exe.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "license:keygen": "node license-cli/license-tool.mjs keygen",
    "license:issue": "node license-cli/license-tool.mjs issue",
    "license:hwid": "node license-cli/license-tool.mjs hwid",
    "license:issue-here": "node license-cli/license-tool.mjs issue-here",
    "record:demo": "node scripts/record-demo.mjs",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-smoke.ps1"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.34.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
