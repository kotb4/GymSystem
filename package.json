{
  "name": "gympro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/build-server.mjs && node dist-server/index.cjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node dist-server/index.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:docs": "node scripts/sync-docs.mjs",
    "license:keygen": "node scripts/license-tool.mjs keygen",
    "license:issue": "node scripts/license-tool.mjs issue",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-smoke.ps1"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
